      {
        "case_id": "case_608",
        "end": 209,
        "quote": "Only the player currently named inspector by badge may read the current assay.",
        "rule_sha256": "5b8361ac1702f4e3a60d8b473033b3459baca9f68a9df3551df4659b93ad9783",
        "source_id": "frozen_v7_rules_text",
        "start": 131
      },
