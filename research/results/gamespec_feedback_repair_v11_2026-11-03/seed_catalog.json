        "case_id": "case_281",
        "end": 141,
        "quote": "At the first of two decisions, only player 1 reads public_label, both players read private_banner and counter, and only player 0 reads token.",
        "rule_sha256": "63d6e17b14c62676cb1ee3340c95fb739585ddaf88b7514ccd54f13c90be4ee5",
        "source_id": "frozen_v7_rules_text",
        "start": 0
      },
      {
        "case_id": "case_281",
        "end": 366,
        "quote": "Between decisions, player 1 puts the SAME public_label value on an open tray where BOTH can read it at decision two. Other permissions do not change.",
        "rule_sha256": "63d6e17b14c62676cb1ee3340c95fb739585ddaf88b7514ccd54f13c90be4ee5",
        "source_id": "frozen_v7_rules_text",
        "start": 217
      }
    ],
    "case_608": [
