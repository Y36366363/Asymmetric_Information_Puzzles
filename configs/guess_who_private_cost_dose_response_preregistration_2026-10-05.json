    "do_not_select_or_refine_dose_grid_after_outcomes": true
  },
  "reporting": {
    "all_preregistered_levels_are_primary_grid": true,
    "retain_positive_zero_ambiguous_and_failed_results": true,
    "no_posthoc_single_cost_replacement": true,
    "no_runtime_epsilon_gto_promotion": true,
    "no_transfer_to_24_character_game": true
  }
}
