{
  "experiment_id": "guess_who_private_question_cost_dose_response_v2",
  "frozen_before_outcome_evaluation": true,
  "rules_id": "strategic_guess_who_private_question_cost_v2",
  "design_basis": "the preregistered 2026-10-04 single-dose experiment produced an independently certified zero result at maximum single-question cost 0.02; this experiment fixes an ex-ante dose grid instead of tuning one cost after observing outcomes",
  "target": {
    "roster_indices": [0, 1, 6],
    "roster_names": ["Ada", "Bruno", "Hugo"],
    "question_ids": ["hair_black", "hair_brown", "glasses", "hat"]
  },
  "private_question_cost_shape": {
