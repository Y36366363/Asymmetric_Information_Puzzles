{
  "experiment_id": "love_letter_four_card_fixed_policy_conditioning_v1",
  "frozen_before_outcome_evaluation": true,
  "scope": "certified_four_card_late_round_subgame_only",
  "game_factory": "LoveLetterCFRGame.late_round_subgame",
  "prior_method_id": "love_letter_chance_reach_combinatorial_prior_v1",
  "fixed_policy": {
    "policy_id": "love_letter_private_hand_full_support_v1",
    "description": "normalize a strictly positive raw weight at every information set; this is an experimental opponent likelihood model, not an equilibrium candidate",
    "raw_weight_formula": "floor + kept_card_coefficient * kept_card + played_card_coefficient * played_card + guard_guess_coefficient * guard_guess_or_zero",
    "floor": 1.0,
    "kept_card_coefficient": 0.75,
    "played_card_coefficient": 0.05,
    "guard_guess_coefficient": 0.02,
    "full_support_required": true,
    "deterministic": true
  },
  "primary_endpoints": {
    "maximum_posterior_l1_shift_from_combinatorial_prior": {
      "positive_threshold": 1e-6
    },
    "information_sets_with_posterior_shift": {
      "positive_threshold": 1e-6,
      "minimum_count": 1
    }
  },
  "mechanical_gates": {
    "expected_total_information_sets": 60,
    "expected_zero_reach_information_sets_under_full_support": 0,
    "maximum_bayes_reconstruction_error": 1e-12,
    "maximum_value_reconstruction_error": 1e-12,
    "maximum_additivity_residual": 1e-12
  },
  "controls": {
    "equilibrium_panel_expected_positive_reach_information_sets": 17,
    "equilibrium_panel_expected_zero_reach_information_sets": 43,
    "equilibrium_panel_expected_shifted_information_sets": 0,
    "equilibrium_maximum_exploitability": 1e-12,
    "fixed_policy_must_fail_equilibrium_gate": 1e-3
  },
  "reporting": {
    "retain_positive_zero_ambiguous_and_failed_results": true,
    "fixed_policy_must_not_be_labeled_gto": true,
    "no_full_round_generalization": true,
    "no_runtime_epsilon_gto_promotion": true
  }
}
